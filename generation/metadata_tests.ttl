<urn:uuid:f094b94f-09b6-4fb0-8ba4-24252a2101c4> a bdqffdq:Specification;
  skos:example "dwc:basisOfRecord=\"Taxon\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:basisOfRecord matches a standard label of one of the Darwin Core classes\"",
    "dwc:basisOfRecord=\"Specimen\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:basisOfRecord does not exactly match a standard label of one of the Darwin Core classes\"";
  bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Darwin Core basisOfRecord\" {[https://dwc.tdwg.org/terms/#dwc:basisOfRecord]}{dwc:basisOfRecord vocabulary [https://rs.gbif.org/vocabulary/dwc/basis_of_record.xml]}";
  bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:basisOfRecord is bdqval:Empty; COMPLIANT if the value of dwc:basisOfRecord is valid in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT";
  rdfs:label "Specification for: VALIDATION_BASISOFRECORD_STANDARD";
  dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:basisOfRecord is bdqval:Empty; COMPLIANT if the value of dwc:basisOfRecord is valid in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"Darwin Core basisOfRecord\" {[https://dwc.tdwg.org/terms/#dwc:basisOfRecord]}{dwc:basisOfRecord vocabulary [https://rs.gbif.org/vocabulary/dwc/basis_of_record.xml]}";
  bdqffdq:hasArgument <urn:uuid:a723528a-ee73-44a7-818d-5315323ec4e9> .

<urn:uuid:a723528a-ee73-44a7-818d-5315323ec4e9> a bdqffdq:Argument;
  bdqffdq:hasArgumentValue "Darwin Core basisOfRecord";
  rdfs:label "Default value for bdqval:sourceAuthority:\"Darwin Core basisOfRecord\"";
  bdqffdq:hasParameter bdqval:sourceAuthority .

bdqtest:f8f3a093-042c-47a3-971a-a482aaaf3b75-2025-03-07 a bdqffdq:Amendment;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  bdqffdq:hasEnhancement bdqenh:Standardized;
  skos:note "The recommended controlled vocabulary for this term consists of \"present\" and \"absent\", which are the only two appropriate terms for a Darwin Core Occurrence. This is reflected in the suggested dwc:occurrenceStatus vocabulary for this Test. Other values for dwc:occurrenceStatus should only arise under circumstances that do not refer to an Occurrence. The GBIF API is listed in the sourceAuthority. However, there is currently a mismatch between the lower case recommended values at https://dwc.tdwg.org/terms/#dwc:occurrenceStatus and the GBIF vocabulary at bdqval:sourceAuthority that uses an upper case first letter (https://api.gbif.org/v1/vocabularies/OccurrenceStatus/concepts), thus implementations using the GBIF API should ensure that matches on alternate terms in that vocabulary are converted to the all lower case values in the present/absent vocabulary recommended in Darwin Core. Implementations should interpret the numeric value 1 as present, and the numeric value 0 as absent.";
  bdqffdq:hasDataQualityDimension bdqdim:Conformance;
  dcterms:description "Proposes an amendment to the value of dwc:occurrenceStatus using the bdqval:sourceAuthority.";
  bdqffdq:hasActedUponInformationElement <urn:uuid:e251108c-ae49-46fa-b5db-d955fd0f4fa4>;
  dcterms:issued "2025-03-07"^^xsd:date;
  skos:historyNote "https://github.com/tdwg/bdq/issues/115";
  rdfs:label "AMENDMENT_OCCURRENCESTATUS_STANDARDIZED";
  dcterms:isVersionOf bdqtest:f8f3a093-042c-47a3-971a-a482aaaf3b75;
  skos:prefLabel "Amendment dwc:occurrenceStatus Standardized for SingleRecord" .

<urn:uuid:abdca718-5564-4dbd-9d98-0a1707d6ecf2> a bdqffdq:AmendmentMethod;
  skos:note "Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)",
    "Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L1119",
