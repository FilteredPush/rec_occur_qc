  bdqffdq:forAmendment bdqtest:f8f3a093-042c-47a3-971a-a482aaaf3b75-2025-03-07;
  bdqffdq:hasSpecification <urn:uuid:fae50773-a832-4e44-87fe-d66a1332c3e7>;
  skos:historyNote "Source: ALA";
  rdfs:label "AmendmentMethod: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED with Specification Specification for: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED";
  skos:prefLabel "AmendmentMethod: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED with Specification Specification for: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED" .

<urn:uuid:fae50773-a832-4e44-87fe-d66a1332c3e7> a bdqffdq:Specification;
  skos:example "dwc:occurrenceStatus=\"1\": Response.status=AMENDED, Response.result=dwc:occurrenceStatus=\"present\", Response.comment=\"Input field contains an interpretable value. \"",
    "dwc:occurrenceStatus=\"X\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"Input field contains uninterpretable value \"X\"";
  bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}";
  bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:ocurrenceStatus is bdqval:Empty; AMENDED the value of dwc:occurrenceStatus if it can be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED";
  rdfs:label "Specification for: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED";
  dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:ocurrenceStatus is bdqval:Empty; AMENDED the value of dwc:occurrenceStatus if it can be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}";
  bdqffdq:hasArgument <urn:uuid:59635d6c-f265-45dd-8814-b80a1dc41540> .

<urn:uuid:59635d6c-f265-45dd-8814-b80a1dc41540> a bdqffdq:Argument;
  bdqffdq:hasArgumentValue "Regex present/absent";
  rdfs:label "Default value for bdqval:sourceAuthority:\"Regex present/absent\"";
  bdqffdq:hasParameter bdqval:sourceAuthority .

bdqtest:7af25f1e-a4e2-4ff4-b161-d1f25a5c3e47-2025-03-07 a bdqffdq:Validation;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  skos:note "The recommended controlled vocabulary for this term consists of \"present\" and \"absent\", which are the only two appropriate terms for a Darwin Core Occurrence. This is reflected in the dwc:occurrenceStatus vocabulary for this Test. There is currently a mismatch between the (authoritative) lower case values at https://dwc.tdwg.org/terms/#dwc:occurrenceStatus and the vocabulary at GBIF (https://api.gbif.org/v1/vocabularies/OccurrenceStatus/concepts), which capitalized the first character. This Test must return NOT_COMPLIANT if there are case differences, leading or trailing whitespace or there are leading or trailing non-printing characters.";
  bdqffdq:hasDataQualityDimension bdqdim:Conformance;
  dcterms:description "Does the value of dwc:occurrenceStatus occur in the bdqval:sourceAuthority?";
  bdqffdq:hasCriterion bdqcrit:Standard;
  bdqffdq:hasActedUponInformationElement <urn:uuid:e251108c-ae49-46fa-b5db-d955fd0f4fa4>;
  dcterms:issued "2025-03-07"^^xsd:date;
  skos:historyNote "https://github.com/tdwg/bdq/issues/116";
  rdfs:label "VALIDATION_OCCURRENCESTATUS_STANDARD";
  dcterms:isVersionOf bdqtest:7af25f1e-a4e2-4ff4-b161-d1f25a5c3e47;
  skos:prefLabel "Validation dwc:occurrenceStatus Standard for SingleRecord" .

