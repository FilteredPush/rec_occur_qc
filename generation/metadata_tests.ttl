  skos:example "dwc:occurrenceID=\"https://www.inaturalist.org/observations/43047701\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:occurrenceID conforms to GUID structure\"",
