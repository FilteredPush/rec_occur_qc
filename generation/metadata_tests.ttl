<urn:uuid:180c1a90-94c3-48b5-a9fe-4223d6f2bd60> a bdqffdq:ValidationMethod;
  skos:note "Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)",
    "Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L635",
